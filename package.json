{
  "name": "nextjs-modernization",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "playwright test",
    "test:unit": "bun run scripts/test-unit.ts",
    "test:e2e": "playwright test",
    "test:all": "bun run test:unit && bun run test:e2e",
    "audit": "bun run scripts/audit-dependencies.ts",
    "newsletter:send-due": "bun run scripts/send-due-newsletters.ts",
    "db:generate": "bunx drizzle-kit generate --config drizzle.config.ts",
    "db:studio": "bunx drizzle-kit studio --config drizzle.config.ts",
    "db:migrate": "bun run scripts/db/migrate.ts",
    "db:migrate:dev": "bun run scripts/db/migrate.ts --env=dev",
    "db:migrate:staging": "bun run scripts/db/migrate.ts --env=staging",
    "db:migrate:prod": "bun run scripts/db/migrate.ts --env=prod",
    "db:check:migrations": "bun run scripts/db/check-schema-migration-sync.ts",
    "db:cleanup-test-data": "bun run scripts/db/cleanup-test-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@aws-sdk/client-s3": "3.1116.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@smithy/core": "3.33.3",
    "@tailwindcss/typography": "0.5.20",
    "cheerio": "1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "gray-matter": "^4.0.3",
    "mermaid": "11.17.0",
    "next": "16.3.2",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "postgres": "3.4.9",
    "posthog-js": "1.418.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "vgpu": "0.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "bun-types": "1.4.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
